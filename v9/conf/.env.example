# GeriApp — Variables de entorno
# Copiar a .env y ajustar valores según el entorno
# NUNCA commitear .env a control de versiones

# ── Base de datos ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u124132715_geriapp
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
DB_TENANT_PREFIX=geriapp_i

# ── MySQL SSL (producción) ────────────────────────────────────
# DB_SSL_CA=/path/to/ca-cert.pem

# ── Integraciones globales para instituciones nuevas ──────────
# Superadmin → Integraciones muestra estos valores enmascarados y los QR Evento
# los usan como defaults al crear instituciones.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=info@example.com
SMTP_PASS=REEMPLAZAR_SMTP_PASS
SMTP_ENCRYPTION=SSL
SMTP_FROM_EMAIL=info@example.com
SMTP_FROM_NAME=GeriApp
SMTP_TIMEOUT=30
SMTP_SANDBOX=0
LEGAL_CC_EMAIL=info@example.com

WHATSAPP_PROVIDER=wasender
WHATSAPP_API_KEY=REEMPLAZAR_WHATSAPP_API_KEY
WHATSAPP_INSTANCE_ID=
WHATSAPP_PHONE=+520000000000
WHATSAPP_ACTIVE=1
WHATSAPP_SANDBOX=0

IA_PROVIDER=deepseek
DEEPSEEK_API_KEY=REEMPLAZAR_DEEPSEEK_API_KEY
DEEPSEEK_MODEL=deepseek-reasoner
